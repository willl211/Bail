# =============================================================================
# ENVIRONNEMENT : DEVELOPMENT (poste local)
# Copier vers backend/.env et frontend/.env.local  ->  npm run env:use development
# =============================================================================

# --- Backend (NestJS) --------------------------------------------------------
NODE_ENV=development
APP_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# Base PostgreSQL locale (docker compose up -d postgres) — port 5433 pour ne pas
# entrer en conflit avec un Postgres déjà installé sur la machine.
DATABASE_URL=postgresql://bail:bail@localhost:5433/bail_dev?schema=public

# Authentification : session serveur + cookie httpOnly (docs/tech-stack.md).
# Pas de JWT — une session doit pouvoir être révoquée immédiatement.
SESSION_COOKIE_NAME=bail_session
SESSION_TTL_DAYS=30
# Le front local est servi en clair : c'est le SEUL environnement où le
# cookie n'est pas réservé au HTTPS.
SESSION_COOKIE_SECURE=false
PASSWORD_SALT_ROUNDS=12

# Adresse publique du front, utilisée pour fabriquer les liens des e-mails
# (confirmation d'adresse, réinitialisation). L'API ne la déduit pas de l'en-tête
# `Host` : un lien porteur d'un secret ne doit pas pouvoir être détourné vers un
# autre domaine.
PUBLIC_SITE_URL=http://localhost:3000

# E-mails transactionnels.
# `mock` écrit les messages dans backend/storage/private/mails/ (ouvrables dans
# un navigateur). `smtp` les envoie pour de vrai — en local, vers Mailpit
# (`docker compose up -d mailpit`), dont l'interface est sur
# http://localhost:8025 : rien ne sort de la machine, et on voit le rendu réel.
MAIL_DRIVER=smtp
MAIL_FROM=Bail <ne-pas-repondre@bail.local>
MAIL_REPLY_TO=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Stockage des fichiers (dossiers locataires, photos d'annonces).
# `local` écrit dans backend/storage/. En staging/prod : OVH Object Storage (S3).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Base des URL de photos d'annonces. Absolue : le front est sur une autre
# origine, une URL relative pointerait vers lui et donnerait un 404.
PUBLIC_ASSET_BASE_URL=http://localhost:4000/uploads

# Stockage objet local, compatible S3 (`npm run storage:up`), pour vérifier le
# driver sans compte chez un hébergeur. Le driver par défaut reste `local` :
# écrire sur le disque suffit en développement, et évite d'exiger un conteneur
# de plus pour lancer le projet.
#
# Pour éprouver le chemin objet : STORAGE_DRIVER=s3, puis relancer l'API.
# Console MinIO sur http://localhost:9001 (bail / bailbailbail).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=bail
S3_SECRET_ACCESS_KEY=bailbailbail
S3_BUCKET_PUBLIC=bail-public
S3_BUCKET_PRIVATE=bail-private
S3_FORCE_PATH_STYLE=true

# --- Intégrations tierces (docs/integrations.md) -----------------------------
# Toutes en sandbox/mock pendant tout le développement. Aucune ne doit bloquer.

# KYC : prestataire non choisi -> driver `mock` obligatoire pour l'instant.
KYC_DRIVER=mock
KYC_MOCK_DEFAULT_RESULT=verified

# Signature électronique : DocuSign, environnement démo.
SIGNATURE_DRIVER=mock
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=

# Paiement : Stripe, clés de test (préfixe sk_test_).
# Aucun compte n'est branché pour l'instant : le code de paiement est complet,
# mais `mock` reste la valeur par défaut. Passer en réel ne demande que de
# renseigner ces trois variables et de mettre PAYMENT_DRIVER=stripe.
PAYMENT_DRIVER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Produit Stripe portant l'abonnement propriétaire, créé une fois dans le
# tableau de bord. Le montant, lui, vient du barème en base.
STRIPE_PRODUCT_ID=

# Visio pour les visites à distance : recommandation Daily.co (non tranché).
VIDEO_DRIVER=mock
DAILY_API_KEY=

# --- Protocole de visite (docs/integrations.md) ------------------------------
# Caméra obligatoire pendant la visite : décision confirmée, non désactivable.
VISIT_RECORDING_RETENTION_DAYS=15

# --- Frontend (Next.js) ------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# URL utilisée côté serveur (SSR) — identique en local, différente en conteneur.
API_INTERNAL_URL=http://localhost:4000/api/v1
