# =============================================================================
# ENVIRONNEMENT : PRODUCTION (hébergé OVH — hébergeur français, RGPD)
# Aucune valeur réelle ici. Secrets gérés hors du repo.
#
# ATTENTION : ne basculer KYC_DRIVER / SIGNATURE_DRIVER / PAYMENT_DRIVER hors
# sandbox qu'une fois le volet juridique bouclé (carte T/G, garantie financière,
# RC Pro, barème d'honoraires figé) — voir docs/legal-context.md.
# =============================================================================

NODE_ENV=production
APP_ENV=production
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=https://bail.fr,https://www.bail.fr

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bail_prod?schema=public&sslmode=require

SESSION_COOKIE_NAME=bail_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=.bail.fr
PASSWORD_SALT_ROUNDS=12
# Adresse publique du front, utilisée pour fabriquer les liens des e-mails
# (confirmation d'adresse, réinitialisation). L'API ne la déduit pas de l'en-tête
# `Host` : un lien porteur d'un secret ne doit pas pouvoir être détourné.
PUBLIC_SITE_URL=

# E-mails transactionnels. Prestataire non tranché : viser un hébergeur de
# messagerie européen (Brevo, Mailjet) pour rester cohérent avec le choix OVH
# fait pour la conformité RGPD (docs/tech-stack.md). Le driver `smtp` parle à
# n'importe lequel — seules ces variables changent.
MAIL_DRIVER=smtp
MAIL_FROM=
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=bail-prod
PUBLIC_ASSET_BASE_URL=https://medias.bail.fr
S3_ACCESS_KEY_ID=__A_RENSEIGNER__
S3_SECRET_ACCESS_KEY=__A_RENSEIGNER__

KYC_DRIVER=mock
KYC_MOCK_DEFAULT_RESULT=verified

SIGNATURE_DRIVER=docusign
DOCUSIGN_BASE_URL=https://na4.docusign.net/restapi
DOCUSIGN_INTEGRATION_KEY=__A_RENSEIGNER__
DOCUSIGN_USER_ID=__A_RENSEIGNER__
DOCUSIGN_ACCOUNT_ID=__A_RENSEIGNER__
DOCUSIGN_PRIVATE_KEY=__A_RENSEIGNER__

PAYMENT_DRIVER=stripe
STRIPE_SECRET_KEY=__A_RENSEIGNER__
STRIPE_WEBHOOK_SECRET=__A_RENSEIGNER__
STRIPE_PRODUCT_ID=__A_RENSEIGNER__

VIDEO_DRIVER=daily
DAILY_API_KEY=__A_RENSEIGNER__

VISIT_RECORDING_RETENTION_DAYS=15

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://bail.fr
NEXT_PUBLIC_API_URL=https://api.bail.fr/api/v1
API_INTERNAL_URL=http://backend:4000/api/v1
