# =============================================================================
# ENVIRONNEMENT : PRODUCTION (hébergé OVH — hébergeur français, RGPD)
# Aucune valeur réelle ici. Secrets gérés hors du repo.
#
# ATTENTION : ne basculer KYC_DRIVER / SIGNATURE_DRIVER / PAYMENT_DRIVER hors
# sandbox qu'une fois le volet juridique bouclé (carte T/G, garantie financière,
# RC Pro, barème d'honoraires figé) — voir docs/legal-context.md.
# =============================================================================

NODE_ENV=production
APP_ENV=production
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=https://seuil.fr,https://www.seuil.fr

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/seuil_prod?schema=public&sslmode=require

JWT_SECRET=__A_GENERER__
JWT_EXPIRES_IN=7d

STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=seuil-prod
S3_ACCESS_KEY_ID=__A_RENSEIGNER__
S3_SECRET_ACCESS_KEY=__A_RENSEIGNER__

KYC_DRIVER=mock
KYC_MOCK_DEFAULT_RESULT=verified

SIGNATURE_DRIVER=docusign
DOCUSIGN_BASE_URL=https://na4.docusign.net/restapi
DOCUSIGN_INTEGRATION_KEY=__A_RENSEIGNER__
DOCUSIGN_USER_ID=__A_RENSEIGNER__
DOCUSIGN_ACCOUNT_ID=__A_RENSEIGNER__
DOCUSIGN_PRIVATE_KEY=__A_RENSEIGNER__

PAYMENT_DRIVER=stripe
STRIPE_SECRET_KEY=__A_RENSEIGNER__
STRIPE_WEBHOOK_SECRET=__A_RENSEIGNER__

VIDEO_DRIVER=daily
DAILY_API_KEY=__A_RENSEIGNER__

VISIT_RECORDING_RETENTION_DAYS=15

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://seuil.fr
NEXT_PUBLIC_API_URL=https://api.seuil.fr/api/v1
API_INTERNAL_URL=http://backend:4000/api/v1
