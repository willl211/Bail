# =============================================================================
# ENVIRONNEMENT : PRODUCTION (hébergé OVH — hébergeur français, RGPD)
# Aucune valeur réelle ici. Secrets gérés hors du repo.
#
# ATTENTION : ne basculer KYC_DRIVER / SIGNATURE_DRIVER / PAYMENT_DRIVER hors
# sandbox qu'une fois le volet juridique bouclé (carte T/G, garantie financière,
# RC Pro, barème d'honoraires figé) — voir docs/legal-context.md.
# =============================================================================

NODE_ENV=production
APP_ENV=production
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=https://whoma.fr,https://www.whoma.fr

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bail_prod?schema=public&sslmode=require

SESSION_COOKIE_NAME=bail_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=.whoma.fr
PASSWORD_SALT_ROUNDS=12
# Adresse publique du front, utilisée pour fabriquer les liens des e-mails
# (confirmation d'adresse, réinitialisation). L'API ne la déduit pas de l'en-tête
# `Host` : un lien porteur d'un secret ne doit pas pouvoir être détourné.
PUBLIC_SITE_URL=

# E-mails transactionnels.
#
# Valeurs valides pour la messagerie d'OVH — offres Zimbra et MX Plan
# confondues, leur documentation précise que les paramètres SMTP/IMAP/POP sont
# strictement identiques.
#
# `SMTP_HOST` s'écrit s-s-**L**-**zéro** : « ssl » suivi du chiffre. Le `l` et
# le `1` se ressemblent dans la plupart des polices de terminal, et l'erreur
# donne un `getaddrinfo ENOTFOUND` qui n'aide pas à la voir.
#
# Port 465 avec `SMTP_SECURE=true` : le chiffrement est immédiat. La
# combinaison 587 / `false` fonctionne aussi — `false` ne veut pas dire « sans
# chiffrement » mais STARTTLS, négocié après l'ouverture.
#
# `MAIL_FROM` doit porter **la même adresse que `SMTP_USER`** : OVH refuse
# d'expédier depuis une boîte qui n'est pas celle authentifiée. C'est pourquoi
# on n'y met pas un `ne-pas-repondre@` qui n'existerait pas.
MAIL_DRIVER=smtp
MAIL_FROM=whoma <contact@whoma.fr>
MAIL_REPLY_TO=contact@whoma.fr
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@whoma.fr
SMTP_PASSWORD=

STORAGE_DRIVER=s3

# Stockage objet OVH. **Deux conteneurs**, jamais un seul avec deux préfixes :
# le conteneur privé porte les pièces d'identité et les bulletins de salaire, il
# doit rester fermé sans exception à prévoir. Un préfixe se contourne par une
# règle d'accès trop large ; deux conteneurs se configurent séparément.
S3_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net
S3_REGION=eu-west-par
S3_BUCKET_PUBLIC=whoma-prod-public
S3_BUCKET_PRIVATE=whoma-prod-private
S3_ACCESS_KEY_ID=__A_RENSEIGNER__
S3_SECRET_ACCESS_KEY=__A_RENSEIGNER__
# Style d'adressage des seaux. **Faux pour les régions 3-AZ d'OVH** (Paris et
# suivantes) : elles n'acceptent que l'hôte virtuel — `seau.s3.region…` — et
# répondent « Not S3 request » à une adresse en chemin. Vérifié contre
# eu-west-par. Les régions 1-AZ historiques acceptent les deux ; MinIO, en
# développement, exige le chemin.
S3_FORCE_PATH_STYLE=false

# En staging/production, les fichiers publics sortent du stockage objet ou du
# CDN, pas de l'API : celle-ci ne sert plus aucun fichier avec le driver `s3`.
PUBLIC_ASSET_BASE_URL=https://whoma-prod-public.s3.eu-west-par.io.cloud.ovh.net

KYC_DRIVER=mock
KYC_MOCK_DEFAULT_RESULT=verified

# Aucun driver DocuSign n'est écrit : le module n'accepte que `mock` et refuse
# de démarrer sur un autre nom. Ce n'est pas un oubli — une intégration écrite
# sans bac à sable ne serait vérifiable par rien (docs/integrations.md). Les
# variables ci-dessous attendent ce jour-là.
SIGNATURE_DRIVER=mock
DOCUSIGN_BASE_URL=https://na4.docusign.net/restapi
DOCUSIGN_INTEGRATION_KEY=__A_RENSEIGNER__
DOCUSIGN_USER_ID=__A_RENSEIGNER__
DOCUSIGN_ACCOUNT_ID=__A_RENSEIGNER__
DOCUSIGN_PRIVATE_KEY=__A_RENSEIGNER__

# `mock` tant qu'aucun compte Stripe n'est branché. Le module est complet :
# passer en réel se réduit à `stripe` et aux trois clés ci-dessous. Attention,
# ça rend aussi l'empreinte bancaire avant visite à nouveau bloquante.
PAYMENT_DRIVER=mock
STRIPE_SECRET_KEY=__A_RENSEIGNER__
STRIPE_WEBHOOK_SECRET=__A_RENSEIGNER__
STRIPE_PRODUCT_ID=__A_RENSEIGNER__

# Aucun prestataire de visio retenu : le module n'accepte que `mock` et les
# salles portent une URL en `.invalid`. Limiter le pilote aux visites
# accompagnées tant que c'est le cas.
VIDEO_DRIVER=mock
DAILY_API_KEY=__A_RENSEIGNER__

VISIT_RECORDING_RETENTION_DAYS=15

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://whoma.fr
NEXT_PUBLIC_API_URL=https://api.whoma.fr/api/v1
API_INTERNAL_URL=http://backend:4000/api/v1
